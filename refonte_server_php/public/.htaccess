# Front controller : toute requête qui ne correspond pas à un fichier ou
# dossier réel de public/ est envoyée à index.php (équivalent de l'écoute
# unique d'Express sur toutes les routes).
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Fichiers de configuration/secrets jamais servis, même par erreur.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "\.(map|lock|yml|yaml)$">
  Require all denied
</FilesMatch>
