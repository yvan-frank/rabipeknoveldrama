# Convention "_PRO" : n'importe quelle variable FOO peut avoir un pendant
# FOO_PRO dans ce même fichier (ex. DATABASE_URL_PRO, JWT_SECRET_PRO). Quand
# APP_ENV=production, sa valeur remplace celle de FOO (cf. applyProductionOverrides
# dans src/Config/Env.php) — même convention que refonte_server (Node), pour
# garder un seul .env dev+prod.

# --- App ---
APP_ENV=development
APP_URL=http://localhost:4000
# Utilisé seulement par le serveur de dev intégré (php -S). En prod/LWS,
# Apache/Nginx écoute sur le port standard et cette valeur est ignorée.
PORT=4000

# --- Database (MySQL, même schéma que refonte_server/prisma/schema.prisma) ---
# format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/rabipek"

# --- Auth ---
JWT_SECRET=change-me-in-env
# JWT posé dans le cookie httpOnly web.
JWT_EXPIRES_IN=7d
# JWT d'accès renvoyé en JSON pour les clients mobiles (Bearer).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30
COOKIE_NAME=rabipek_token

# Audience attendue sur le idToken Google (mobile, connexion "Continuer avec
# Google") — doit être identique à GOOGLE_CLIENT_ID de refonte_rabi_mobile/.env.local.
# Optionnel : l'endpoint POST /auth/google échoue proprement si absent.
GOOGLE_CLIENT_ID=

# --- Chiffrement du contenu des chapitres ---
CONTENT_ENCRYPTION_KEY=

# --- CORS (liste d'origines séparées par des virgules) ---
# localhost:3000 = refonte_rabi_frontend (Next.js) ; localhost:8000 =
# refonte_frontend_php, dont les îlots React appellent cette API en
# cross-origin depuis le navigateur (cf. frontend-react/src/lib/apiClient.ts).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://rabipeknovel.com,https://www.rabipeknovel.com

# --- Uploads ---
UPLOADS_DIR=public/uploads

# --- EPUB ---
# Driver "s3" non porté par ce scaffold (cf. src/Modules/Epub/EpubStorage.php) — "local" uniquement.
EPUB_STORAGE_DRIVER=local
EPUB_STORAGE_DIR=private/epub
# Liste blanche des hôtes externes pour les images intégrées aux EPUB (couvertures, images de chapitre).
# Exemple : cdn.example.com,images.example.net
EPUB_EXTERNAL_IMAGE_HOSTS=
# Chemin vers le JAR EPUBCheck (facultatif — validation structurelle interne active sans lui).
EPUBCHECK_JAR_PATH=
EPUBCHECK_REQUIRED=false
