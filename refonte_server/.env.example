# Convention "_PRO" : n'importe quelle variable FOO peut avoir un pendant
# FOO_PRO dans ce même fichier (ex. DATABASE_URL_PRO, JWT_SECRET_PRO). Quand
# NODE_ENV=production, sa valeur remplace celle de FOO (cf. applyProductionOverrides
# dans src/config/env.ts) — un seul .env à maintenir pour dev ET prod, pas un
# .env.production séparé qui finit par diverger.

# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# --- Database (MySQL via Prisma) ---
# format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/rabipek"

# --- Auth ---
JWT_SECRET=change-me-in-env
# JWT posé dans le cookie httpOnly web.
JWT_EXPIRES_IN=7d
# JWT d'accès renvoyé en JSON pour les clients mobiles (Bearer). Volontairement
# court : le renouvellement passe par POST /auth/refresh (refresh token révocable).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30
COOKIE_NAME=rabipek_token

# --- Chiffrement du contenu des chapitres ---
# Générez-la une seule fois et conservez-la dans votre coffre à secrets :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTENT_ENCRYPTION_KEY=

# --- EPUB ---
# Liste blanche des hôtes externes pour les images intégrées aux livres.
# Exemple : cdn.example.com,images.example.net
EPUB_EXTERNAL_IMAGE_HOSTS=
# Chemin vers le JAR EPUBCheck dans l'environnement de déploiement.
EPUBCHECK_JAR_PATH=
# true en production une fois EPUBCheck installé.
EPUBCHECK_REQUIRED=false

# --- Stockage des fichiers EPUB générés ---
# "local" (par défaut, dev) : écrit sur disque, à monter sur un volume
# persistant en production. "s3" : stockage objet durable (AWS S3, MinIO,
# Cloudflare R2, DigitalOcean Spaces...), recommandé en production.
EPUB_STORAGE_DRIVER=local
# Utilisé uniquement par le driver "local". Relatif au dossier du serveur si non absolu.
EPUB_STORAGE_DIR=private/epub
# Requis si EPUB_STORAGE_DRIVER=s3.
EPUB_S3_BUCKET=
EPUB_S3_REGION=auto
# Laisser vide pour AWS S3. Requis pour MinIO/R2/Spaces (ex: https://<account>.r2.cloudflarestorage.com).
EPUB_S3_ENDPOINT=
EPUB_S3_ACCESS_KEY_ID=
EPUB_S3_SECRET_ACCESS_KEY=
# true pour MinIO et certains fournisseurs S3-compatible.
EPUB_S3_FORCE_PATH_STYLE=false
EPUB_S3_PREFIX=epub

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000,https://rabipeknovel.com,https://www.rabipeknovel.com

# --- Redis (cache / view counters) ---
REDIS_URL=redis://localhost:6379

# --- Mail (nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_SENDER_NAME=Rabipek
MAIL_SENDER_ADDRESS=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
