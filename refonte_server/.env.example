# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# --- Database (MySQL via Prisma) ---
# format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/rabipek"

# --- Auth ---
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=7d
COOKIE_NAME=rabipek_token

# --- Chiffrement du contenu des chapitres ---
# Générez-la une seule fois et conservez-la dans votre coffre à secrets :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTENT_ENCRYPTION_KEY=

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000,https://rabipeknovel.com,https://www.rabipeknovel.com

# --- Redis (cache / view counters) ---
REDIS_URL=redis://localhost:6379

# --- Mail (nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_SENDER_NAME=Rabipek
MAIL_SENDER_ADDRESS=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
