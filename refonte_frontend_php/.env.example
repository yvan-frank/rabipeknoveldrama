# Convention "_PRO" : n'importe quelle variable FOO peut avoir un pendant
# FOO_PRO dans ce même fichier (ex. API_URL_PRO). Quand APP_ENV=production,
# sa valeur remplace celle de FOO — même convention que refonte_server_php.

# --- App ---
APP_ENV=development
APP_URL=http://localhost:8000
# Utilisé seulement par le serveur de dev intégré (php -S).
PORT=8000

# --- API backend (refonte_server_php / refonte_server) ---
API_URL=http://localhost:4000/api
API_URL_PRO=https://api.rabipeknovel.com/api

# --- Cookie de session (doit correspondre à COOKIE_NAME du backend) ---
COOKIE_NAME=rabipek_token

# --- Site public ---
SITE_URL=https://rabipeknovel.com

# --- Vite (îlots React) ---
# En dev : le PHP sert des <script type="module"> pointant vers ce serveur
# Vite (npm run dev dans frontend-react/). En prod : ignoré, on lit
# public/build/.vite/manifest.json généré par `npm run build`.
VITE_DEV_SERVER_URL=http://localhost:5173

# --- App mobile (lecture d'un chapitre indisponible sur le web) ---
# Doit correspondre à `scheme` dans refonte_rabi_mobile/app.config.ts.
MOBILE_APP_SCHEME=rabipek
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.frank00.rabipek
# Vide tant que l'app n'est pas publiée sur l'App Store.
APP_STORE_URL=

# --- Connexion Google (bouton GoogleAuthButton sur /connexion, /inscription) ---
# Client OAuth "Web application" (Google Cloud Console) — DIFFÉRENT du
# GOOGLE_CLIENT_ID de refonte_server_php/.env (mobile). Le idToken produit
# est envoyé à POST /auth/google, qui accepte les deux audiences.
GOOGLE_CLIENT_ID=
