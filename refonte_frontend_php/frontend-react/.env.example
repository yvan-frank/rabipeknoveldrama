# Convention Vite native (PAS le suffixe "_PRO" utilisé côté PHP,
# apiClient.ts ne lit que VITE_API_URL) : .env.development pour `npm run dev`,
# .env.production pour `npm run build` — voir .env.development/.env.production
# (non versionnés) à côté de ce fichier.
VITE_API_URL=http://localhost:4000/api
